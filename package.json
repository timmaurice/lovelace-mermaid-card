{
  "name": "mermaid-card",
  "version": "1.1.0",
  "description": "A Home Assistant Lovelace card that renders Mermaid diagrams with live entity states.",
  "main": "dist/mermaid-card.js",
  "scripts": {
    "build": "rollup -c",
    "check-format": "prettier --check .",
    "format": "prettier . --write",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "watch": "rollup -c -w",
    "pretest:e2e": "node scripts/ensure-deps.mjs && npm run build",
    "test:e2e": "playwright test",
    "catalog": "npm run build && CATALOG=1 playwright test catalog.spec.ts"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lit": "^3.3.3",
    "mermaid": "^12.3.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.8",
    "rollup-plugin-lit-css": "^6.0.3",
    "sass": "^1.108.2",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "homepage": "https://github.com/timmaurice/lovelace-mermaid-card#readme",
  "bugs": {
    "url": "https://github.com/timmaurice/lovelace-mermaid-card/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timmaurice/lovelace-mermaid-card.git"
  },
  "license": "MIT",
  "author": "Tim Maurice Bayer"
}
